# Safe default: no live services. Copy locally without overwriting an existing .env.
# Never put keys in chat, screenshots, VITE_* variables or source code.
# Docker defaults to Mock. compose.live.yaml explicitly enables live providers
# and passes only its listed settings; .env is not copied into the image.
MIRA_ENABLE_LIVE_APIS=false
MIRA_PROVIDER=mock
MIRA_SPEECH_PROVIDER=mock
PORT=3001

# To enable text deliberately: gate=true and MIRA_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# To enable speech deliberately: gate=true and MIRA_SPEECH_PROVIDER=qwen.
# User selected China (Beijing). Use a Beijing-region key.
# Official compatible endpoint is prefilled; ASR may use your workspace-specific domain.
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_WORKSPACE_ID=
QWEN_ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_TTS_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_TTS_MODEL=qwen3-tts-flash-realtime
QWEN_TTS_VOICE=Chelsie
# See docs/LIVE_SETUP.md for official endpoint formats and explicit-start instructions.

# Product amount/request caps were removed at the user's request.
# MIRA_BILLING_CONFIRMED and MIRA_MAX_LIVE_REQUESTS are obsolete and ignored.
# Live API usage is billed by the provider; MIRA_ENABLE_LIVE_APIS remains explicit.

# Optional deployment settings; local root Mock remains the default.
MIRA_BASE_PATH=
MIRA_PUBLIC_ORIGIN=
MIRA_AUTH_REQUIRED=false
MIRA_PASSWORD_HASH=
# Defaults: dist and .local. Production uses build/client and /var/lib/mira-cafe.
MIRA_STATIC_DIR=dist
MIRA_STATE_DIR=.local
# Never use VITE_* for keys/passwords. See docs/DEPLOYMENT.md.

# Server-side adapter only: the current app does not instantiate it or expose
# image-generation routes. No ComfyUI installation or GPU service is required.
# Offline contract demo: npm run demo:media (always Mock unless --live is passed).
MIRA_MEDIA_PROVIDER=disabled
MIRA_ENABLE_MEDIA_APIS=false
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Required for explicit external-service demo. API-format graph + node bindings.
# workflows/comfyui-lodge.example.json is UNVERIFIED and contains a model placeholder.
COMFYUI_WORKFLOW_SPEC=
# See docs/COMFYUI_ADAPTER.md. Keep production disabled; no localhost tunnelling.
