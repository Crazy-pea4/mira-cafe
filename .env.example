# Safe default: no live services. Copy locally without overwriting an existing .env.
# Never put keys in chat, screenshots, VITE_* variables or source code.
MIRA_ENABLE_LIVE_APIS=false
MIRA_PROVIDER=mock
MIRA_SPEECH_PROVIDER=mock
PORT=3001

# To enable text deliberately: gate=true and MIRA_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# To enable speech deliberately: gate=true and MIRA_SPEECH_PROVIDER=qwen.
# User selected China (Beijing). Use a Beijing-region key.
# Official compatible endpoint is prefilled; ASR may use your workspace-specific domain.
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_WORKSPACE_ID=
QWEN_ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_TTS_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_TTS_MODEL=qwen3-tts-flash-realtime
QWEN_TTS_VOICE=Chelsie
# See docs/LIVE_SETUP.md for official endpoint formats and explicit-start instructions.

# Combined DeepSeek + Qwen test budget: CNY 10; local stop at CNY 8 reserved.
# Keep off until local price/usage/account checks are complete. This is not an invoice.
MIRA_BILLING_CONFIRMED=false
# May only lower the 60-request global maximum; no automatic reset/refund.
MIRA_MAX_LIVE_REQUESTS=60
