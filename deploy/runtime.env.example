# Template only. Never place real values in this tracked example.
NODE_ENV=production
PORT=3001
MIRA_BASE_PATH=/mira
MIRA_PUBLIC_ORIGIN=https://iamm.xyz
MIRA_AUTH_REQUIRED=true
MIRA_PASSWORD_HASH=
MIRA_STATIC_DIR=build/client
MIRA_STATE_DIR=/var/lib/mira-cafe
MIRA_ENABLE_LIVE_APIS=true
MIRA_PROVIDER=deepseek
MIRA_SPEECH_PROVIDER=qwen
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_WORKSPACE_ID=
QWEN_ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_TTS_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_TTS_MODEL=qwen3-tts-flash-realtime
QWEN_TTS_VOICE=Chelsie
