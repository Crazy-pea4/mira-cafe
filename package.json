{
  "name": "mira-cafe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:media": "node --import tsx scripts/media-adapter-demo.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start:configured": "node --env-file=.env --import tsx server/index.ts",
    "dev:configured": "node --env-file=.env scripts/dev.mjs",
    "build:deploy": "npm run typecheck && MIRA_BASE_PATH=/mira vite build --outDir build/client && vite build --config vite.server.config.ts",
    "start:production": "node build/server/index.js",
    "check:deploy": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "@fastify/websocket": "11.3.4",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.0.5"
  }
}
